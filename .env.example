# Never commit real credentials. Used only by the local Streamable HTTP MCP
# transport; STDIO relies on the local process boundary and does not use it.
QKERN_MCP_TOKEN=replace-with-a-short-lived-token
QKERN_MCP_ORGANIZATION_ID=org_moqro
QKERN_MCP_PROJECT_ID=prj_novamarket
QKERN_MCP_ENVIRONMENT=development
# Stable, non-secret audit identity for the local MCP process. The apply-queue
# tool is a destructive write and must remain client-prompted.
QKERN_MCP_ACTOR_REF=local-mcp-agent
# Optional local HTTP-token expiry. The static-Bearer HTTP transport refuses to
# start in production; a remote deployment must implement the documented OAuth gate.
QKERN_MCP_TOKEN_EXPIRES_AT=replace-with-an-iso-timestamp
QKERN_APP_ORIGINS=http://localhost:3000
QKERN_PASSWORD_PEPPER=replace-with-a-long-random-runtime-secret
# Project Auth is an independent application-user provider and remains disabled
# until its exact origins and secrets are configured. Development may use the
# shown loopback HTTP origin; Production accepts HTTPS only and requires an
# injected delivery adapter for verification, Magic Link and reset messages.
QKERN_PROJECT_AUTH_ENABLED=false
QKERN_PROJECT_AUTH_ALLOWED_ORIGINS=http://localhost:3000
QKERN_PROJECT_AUTH_REDIRECT_ORIGINS=http://localhost:3000
QKERN_PROJECT_AUTH_CALLBACK_BASE_URL=http://localhost:3000
QKERN_PROJECT_AUTH_ISSUER_BASE_URL=http://localhost:3000
QKERN_PROJECT_AUTH_PASSWORD_PEPPER=replace-with-a-distinct-long-random-secret
# SMTP delivery for verification, Magic Link and password reset messages.
# Without QKERN_PROJECT_AUTH_SMTP_HOST the delivery port stays fail-closed: a
# deployment that forgets its mail configuration refuses to issue action tokens
# instead of silently dropping them. Production requires TLS; "plaintext" is
# refused there and username plus password are never sent unencrypted.
# QKERN_PROJECT_AUTH_SMTP_HOST=smtp.example.com
# QKERN_PROJECT_AUTH_SMTP_PORT=587
# starttls (default) | implicit_tls | plaintext (development only)
# QKERN_PROJECT_AUTH_SMTP_SECURITY=starttls
# QKERN_PROJECT_AUTH_SMTP_USERNAME=
# QKERN_PROJECT_AUTH_SMTP_PASSWORD=
# QKERN_PROJECT_AUTH_SMTP_SENDER=no-reply@example.com
# Application page that consumes the token. The link carries token, type and
# redirect_to; that page posts them to /auth/verify. HTTPS outside loopback.
# QKERN_PROJECT_AUTH_ACTION_BASE_URL=https://app.example.com/auth/callback
# 32 random bytes in base64url, used only to encrypt TOTP/OIDC flow secrets and
# HMAC one-time recovery codes. Rotate only through a controlled migration.
QKERN_PROJECT_AUTH_MFA_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64url
# Ed25519 PKCS8 DER encoded as base64 plus a non-secret rotation ID. Production
# requires both. Retain up to five old public JWKs during access-token overlap.
QKERN_PROJECT_AUTH_SIGNING_KEY_ID=project-auth-key-2026-08
QKERN_PROJECT_AUTH_SIGNING_PRIVATE_KEY_BASE64=replace-with-ed25519-pkcs8-der-base64
# QKERN_PROJECT_AUTH_PREVIOUS_JWKS_JSON={"keys":[]}
QKERN_PROJECT_AUTH_ACCESS_TTL_SECONDS=900
QKERN_PROJECT_AUTH_REFRESH_TTL_SECONDS=2592000
# Local testing only: returns delivery tokens in responses and uses no email
# adapter. Production refuses to start Project Auth when this is true.
QKERN_PROJECT_AUTH_DEV_EXPOSE_TOKENS=false
# Project Storage is independently disabled by default. Buckets start private;
# every upload is bound to an exact byte size, safe MIME type and SHA-256 and
# remains quarantined until an injected scanner returns clean.
QKERN_PROJECT_STORAGE_ENABLED=false
QKERN_PROJECT_STORAGE_ALLOWED_ORIGINS=http://localhost:3000
QKERN_PROJECT_STORAGE_GRANT_TTL_SECONDS=300
QKERN_PROJECT_STORAGE_PROVIDER_TIMEOUT_MS=10000
# Key for the encrypted copy of S3 access key secrets (2.96): 32 bytes as hex or
# base64url. Without it, issued pairs carry no ciphertext and the S3 endpoint at
# /s3 accepts none of them; production requires it while Storage is enabled.
# QKERN_PROJECT_STORAGE_S3_KEY_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64url
# Development-only S3-compatible adapter. Configure all five values together.
# Production rejects raw environment credentials and requires injected rotating
# credential, object-provider and malware-scanner adapters.
# QKERN_PROJECT_STORAGE_S3_ENDPOINT=http://localhost:9000
# QKERN_PROJECT_STORAGE_S3_REGION=us-east-1
# QKERN_PROJECT_STORAGE_S3_BUCKET=qkern-project-storage
# QKERN_PROJECT_STORAGE_S3_ACCESS_KEY_ID=qkern_local_access
# QKERN_PROJECT_STORAGE_S3_SECRET_ACCESS_KEY=qkern_local_password_change_me_32bytes
# QKERN_PROJECT_STORAGE_S3_SESSION_TOKEN=optional-development-session-token
# Optional development/CI ClamAV adapter. The clamd TCP port must remain private;
# scanner failures, timeouts, over-limit objects and checksum drift stay quarantined.
# Production still requires an injected scanner and egress/network policy.
# QKERN_PROJECT_STORAGE_CLAMAV_HOST=127.0.0.1
# QKERN_PROJECT_STORAGE_CLAMAV_PORT=3310
# QKERN_PROJECT_STORAGE_SCANNER_CONNECT_TIMEOUT_MS=3000
# QKERN_PROJECT_STORAGE_SCANNER_TIMEOUT_MS=60000
# QKERN_PROJECT_STORAGE_SCANNER_DOWNLOAD_TIMEOUT_MS=30000
# QKERN_PROJECT_STORAGE_SCANNER_MAX_OBJECT_BYTES=26214400
# Optional fixed OIDC providers. Endpoint URLs are server authority, HTTPS-only,
# no-redirect and never accepted from a request. Secrets are referenced by env
# variable name, not embedded in this JSON.
# QKERN_PROJECT_AUTH_OIDC_PROVIDERS_JSON=[{"id":"example","issuer":"https://id.example.com","authorizationEndpoint":"https://id.example.com/oauth/authorize","tokenEndpoint":"https://id.example.com/oauth/token","jwksUri":"https://id.example.com/.well-known/jwks.json","clientId":"replace-client-id","clientSecretEnv":"QKERN_PROJECT_AUTH_OIDC_SECRET_EXAMPLE","scopes":["openid","email","profile"]}]
# QKERN_PROJECT_AUTH_OIDC_SECRET_EXAMPLE=replace-with-provider-secret
# Optional fixed SAML 2.0 providers, at most ten. The certificate is the
# provider's, PEM, and every signature is checked against exactly this one.
# signAuthnRequest is off unless a provider demands a signed request; switching
# it on needs the own key pair below, or starting a flow refuses.
# QKERN_PROJECT_AUTH_SAML_PROVIDERS_JSON=[{"id":"example","entityId":"https://id.example.com/metadata","singleSignOnUrl":"https://id.example.com/sso","certificate":"-----BEGIN CERTIFICATE-----\nreplace\n-----END CERTIFICATE-----\n"}]
# QKERN's OWN key pair as a service provider: the certificate that the metadata
# route publishes, and the private key that signs an AuthnRequest. Both halves
# or neither; a half pair refuses at startup. The two must belong together, and
# that is checked, because otherwise the metadata would name one certificate
# while another key signs, and it would only surface at the provider.
# QKERN_PROJECT_AUTH_SAML_SP_CERTIFICATE_PEM=
# QKERN_PROJECT_AUTH_SAML_SP_PRIVATE_KEY_PEM=
# Set only behind a controlled reverse proxy; selects the client address before
# this many trusted hops. Leave unset for the fail-closed shared bucket.
QKERN_TRUST_PROXY_HOPS=1
# Use memory only for local demonstration/tests. Production rejects it.
# postgres selects the persistent auth, tenancy and control-plane adapters together.
QKERN_RUNTIME_MODE=postgres
# Migration-owner credential. Never expose this URL to application traffic.
DATABASE_URL=postgresql://qkern:qkern_local_only@localhost:5432/qkern_control
# Separate least-privilege LOGIN roles: runtime is RLS-constrained control-plane
# access; auth can only access auth/session data and membership discovery.
QKERN_RUNTIME_DATABASE_URL=postgresql://qkern_app:qkern_runtime_local_only@localhost:5432/qkern_control
QKERN_AUTH_DATABASE_URL=postgresql://qkern_auth_app:qkern_auth_local_only@localhost:5432/qkern_control
# Dedicated queue/lease transition login. Never reuse the web runtime or owner credential.
QKERN_WORKER_DATABASE_URL=postgresql://qkern_worker_app:qkern_worker_local_only@localhost:5432/qkern_control
# Dedicated project-database provisioner login. This role cannot authenticate,
# mutate queues or read auth data through any other QKERN boundary.
QKERN_PROVISIONER_DATABASE_URL=postgresql://qkern_provisioner_app:qkern_provisioner_local_only@localhost:5432/qkern_control
# Project provisioning is disabled by default and one runtime is bound to one tenant.
QKERN_PROJECT_PROVISIONER_ENABLED=false
QKERN_PROVISIONER_ORGANIZATION_ID=replace-with-an-organization-uuid
QKERN_PROJECT_PROVISIONER_ID=local-provisioner-1
QKERN_PROVISIONER_LEASE_MS=60000
QKERN_PROVISIONER_RETRY_BASE_MS=1000
QKERN_PROVISIONER_RETRY_MAX_MS=60000
QKERN_PROVISIONER_IDLE_MS=1000
# Reference-only infrastructure broker. Production requires exact HTTPS/443,
# a private rotating signing-key file and at least 1000ms lease headroom.
QKERN_PROVISIONING_BROKER_URL=https://provisioner.service.internal/qkern/projects
QKERN_PROVISIONING_BROKER_ALLOWED_HOSTS=provisioner.service.internal
QKERN_PROVISIONING_BROKER_TIMEOUT_MS=20000
QKERN_PROVISIONING_BROKER_SIGNING_KEY_FILE=/run/qkern/provisioning-broker-key.json
# Development only; Production rejects inline signing keys.
# QKERN_PROVISIONING_BROKER_HMAC_KEY_ID=local-key-version
# QKERN_PROVISIONING_BROKER_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Disabled-by-default OpenMetrics exporter for external SLO scraping. It is
# bound to one tenant, requires PostgreSQL mode and rereads a dedicated private
# bearer-token file on every request. Inline or authority-reused tokens fail.
QKERN_PROVISIONING_METRICS_ENABLED=false
QKERN_PROVISIONING_METRICS_ORGANIZATION_ID=replace-with-an-organization-uuid
QKERN_PROVISIONING_METRICS_TOKEN_FILE=/run/qkern/provisioning-metrics-token
# Optional signed control-plane backup/restore drill evidence. The verifier
# private key stays in the external drill runner. QKERN reads only the strict
# evidence envelope and an Ed25519 public-key file, pinned by the SHA-256 of
# the decoded 32-byte public key. Production rejects links and group/world
# writable files. Enabling this flag adds only fixed readiness metrics; stale
# or invalid evidence makes the authenticated metrics scrape fail closed.
QKERN_BACKUP_RESTORE_EVIDENCE_ENABLED=false
QKERN_BACKUP_RESTORE_EVIDENCE_FILE=/run/qkern/backup-restore-evidence.json
QKERN_BACKUP_RESTORE_VERIFIER_KEY_FILE=/run/qkern/backup-restore-verifier-key.json
QKERN_BACKUP_RESTORE_VERIFIER_KEY_SHA256=replace-with-64-lowercase-hex
# What the operator declares about the WAL archive, for Database -> Point-in-time
# Recovery in the console (2.53). QKERN neither manages nor reads a WAL archive,
# so these are declarations and not findings, and the page says so. There is
# deliberately no variable for the location of the archive: no connection
# string, no bucket and no key can leave through that page. Retention is 1..730
# days; the start of archiving is a UTC timestamp with milliseconds. An unusable
# value is dropped and reported by its variable name, never by its value.
QKERN_BACKUP_WAL_ARCHIVE_DECLARED=false
QKERN_BACKUP_WAL_ARCHIVE_RETENTION_DAYS=
QKERN_BACKUP_WAL_ARCHIVE_SINCE=
# Worker/outbox runtimes are disabled unless explicitly enabled and tenant-bound.
QKERN_MIGRATION_WORKER_ENABLED=false
QKERN_WORKER_ORGANIZATION_ID=replace-with-an-organization-uuid
QKERN_MIGRATION_WORKER_ID=local-worker-1
# Optional per-process liveness/readiness listener. It is absent by default,
# binds only to loopback and must be used through an in-container exec probe,
# never through a Service or Ingress. Co-located runtimes need unique ports.
#
# Until 1.46 no process ever started it: four compositions threaded a `probe`
# through and nobody created one. The compute runtime starts it since 1.46 and
# feeds it from the cron and webhook loops, so /ready turns 503 when every
# definition keeps failing - a state that used to look exactly like an idle
# loop. The body stays "ready" or "not ready"; it never says what broke.
QKERN_RUNTIME_PROBE_ENABLED=false
QKERN_RUNTIME_PROBE_HOST=127.0.0.1
QKERN_RUNTIME_PROBE_PORT=9464
QKERN_RUNTIME_PROBE_STALE_AFTER_MS=120000
# Offline render/verification gate for the four hardened Kubernetes background
# workloads. The image must be pinned by a real non-placeholder sha256 digest.
# The generated bundle contains references only, never ConfigMap/Secret values.
QKERN_RUNTIME_DEPLOYMENT_NAMESPACE=qkern
QKERN_RUNTIME_IMAGE=registry.example.com/qkern/platform@sha256:replace-with-64-lowercase-hex
QKERN_RUNTIME_CONFIG_MAP=qkern-runtime-config
QKERN_RUNTIME_SECRET=qkern-runtime-secrets
QKERN_RUNTIME_DEPLOYMENT_FILE=/secure/qkern-runtime-deployments.json
# Optional signed live-certification gate. QKERN owns no cluster credentials and
# no private signing key. All three policy hashes and the verifier-key hash are
# lowercase SHA-256 pins and must represent distinct reviewed artifacts.
QKERN_RUNTIME_DEPLOYMENT_EVIDENCE_ENABLED=false
QKERN_RUNTIME_DEPLOYMENT_EVIDENCE_FILE=/run/qkern/runtime-deployment-evidence.json
QKERN_RUNTIME_DEPLOYMENT_VERIFIER_KEY_FILE=/run/qkern/runtime-deployment-verifier-key.json
QKERN_RUNTIME_DEPLOYMENT_VERIFIER_KEY_SHA256=replace-with-64-lowercase-hex
QKERN_RUNTIME_DEPLOYMENT_CLUSTER_ID_SHA256=replace-with-64-lowercase-hex
QKERN_RUNTIME_DEPLOYMENT_NETWORK_POLICY_SHA256=replace-with-64-lowercase-hex
QKERN_RUNTIME_IMAGE_PROVENANCE_SHA256=replace-with-64-lowercase-hex
# Optional signed real-service certification. The independent runner must use
# managed PostgreSQL 17 and complete all 15 provisioning, Vault/TLS, migration,
# crash/reconciliation, stale-worker cancellation, tenant-isolation, broker,
# Pager and monitoring scenarios. The seven reviewed inputs plus public-key pin
# must be pairwise distinct. The two evidence digests bind the exact signed
# backup/restore and runtime-deployment envelopes into the same test run.
QKERN_PROVIDER_E2E_EVIDENCE_ENABLED=false
QKERN_PROVIDER_E2E_EVIDENCE_FILE=/run/qkern/provider-e2e-evidence.json
QKERN_PROVIDER_E2E_VERIFIER_KEY_FILE=/run/qkern/provider-e2e-verifier-key.json
QKERN_PROVIDER_E2E_VERIFIER_KEY_SHA256=replace-with-64-lowercase-hex
QKERN_PROVIDER_E2E_PROVIDER_ID_SHA256=replace-with-64-lowercase-hex
QKERN_PROVIDER_E2E_PROVIDER_CONFIG_SHA256=replace-with-64-lowercase-hex
QKERN_PROVIDER_E2E_BROKER_CONTRACT_SHA256=replace-with-64-lowercase-hex
QKERN_PROVIDER_E2E_VAULT_POLICY_SHA256=replace-with-64-lowercase-hex
QKERN_PROVIDER_E2E_PAGER_ROUTING_SHA256=replace-with-64-lowercase-hex
QKERN_PROVIDER_E2E_BACKUP_RESTORE_EVIDENCE_SHA256=replace-with-64-lowercase-hex
QKERN_PROVIDER_E2E_RUNTIME_DEPLOYMENT_EVIDENCE_SHA256=replace-with-64-lowercase-hex
# Optional independent release-security certification. The auditor retains the
# private key and supplies the signed envelope plus a dedicated pinned Ed25519
# public key. Eight distinct pins bind the exact release, SBOM and assessment
# reports. Enabling readiness makes an invalid or stale certificate fail closed.
QKERN_SECURITY_ASSESSMENT_EVIDENCE_ENABLED=false
QKERN_SECURITY_ASSESSMENT_EVIDENCE_FILE=/run/qkern/security-assessment-evidence.json
QKERN_SECURITY_ASSESSMENT_VERIFIER_KEY_FILE=/run/qkern/security-assessment-verifier-key.json
QKERN_SECURITY_ASSESSMENT_VERIFIER_KEY_SHA256=replace-with-64-lowercase-hex
QKERN_SECURITY_ASSESSMENT_RELEASE_ARTIFACT_SHA256=replace-with-64-lowercase-hex
QKERN_SECURITY_ASSESSMENT_SBOM_SHA256=replace-with-64-lowercase-hex
QKERN_SECURITY_ASSESSMENT_DEPENDENCY_AUDIT_SHA256=replace-with-64-lowercase-hex
QKERN_SECURITY_ASSESSMENT_SAST_REPORT_SHA256=replace-with-64-lowercase-hex
QKERN_SECURITY_ASSESSMENT_DAST_REPORT_SHA256=replace-with-64-lowercase-hex
QKERN_SECURITY_ASSESSMENT_SECRET_SCAN_REPORT_SHA256=replace-with-64-lowercase-hex
QKERN_SECURITY_ASSESSMENT_CROSS_TENANT_REPORT_SHA256=replace-with-64-lowercase-hex
QKERN_SECURITY_ASSESSMENT_PENTEST_REPORT_SHA256=replace-with-64-lowercase-hex
# The combined preflight hashes this exact packaged release and all four
# evidence envelopes before Production Apply can consume the same five pins.
QKERN_RELEASE_ARTIFACT_FILE=/secure/QKERN_Source_v1.8.0-alpha.1.zip
# Production Apply is a separate, disabled-by-default release authority. When
# enabled, both the queue service and the worker reread an exact Change-Set-
# bound Ed25519 authorization. The five evidence pins and the decoded public-
# key pin must all be distinct lowercase SHA-256 values. No private signing key
# belongs in QKERN. Subject values below are used only by the preflight CLI;
# the API and worker derive the same subject from trusted persisted records.
QKERN_PRODUCTION_APPLY_ENABLED=false
QKERN_PRODUCTION_APPLY_AUTHORIZATION_FILE=/run/qkern/production-apply-authorization.json
QKERN_PRODUCTION_APPLY_VERIFIER_KEY_FILE=/run/qkern/production-apply-verifier-key.json
QKERN_PRODUCTION_APPLY_VERIFIER_KEY_SHA256=replace-with-64-lowercase-hex
QKERN_PRODUCTION_APPLY_RELEASE_ARTIFACT_SHA256=replace-with-64-lowercase-hex
QKERN_PRODUCTION_APPLY_BACKUP_RESTORE_EVIDENCE_SHA256=replace-with-64-lowercase-hex
QKERN_PRODUCTION_APPLY_RUNTIME_DEPLOYMENT_EVIDENCE_SHA256=replace-with-64-lowercase-hex
QKERN_PRODUCTION_APPLY_PROVIDER_E2E_EVIDENCE_SHA256=replace-with-64-lowercase-hex
QKERN_PRODUCTION_APPLY_SECURITY_ASSESSMENT_SHA256=replace-with-64-lowercase-hex
# The RC readiness preflight requires every evidence/metrics flag above to be
# true, the three organization UUIDs to match, HTTPS-only QKERN_APP_ORIGINS,
# QKERN_RUNTIME_PROBE_ENABLED=true and this Apply switch to remain false. It
# never deploys workloads and never generates an Apply authorization.
# QKERN_PRODUCTION_APPLY_SUBJECT_ORGANIZATION_ID=replace-with-an-organization-uuid
# QKERN_PRODUCTION_APPLY_SUBJECT_PROJECT_ID=replace-with-a-project-uuid
# QKERN_PRODUCTION_APPLY_SUBJECT_CHANGE_SET_ID=replace-with-a-change-set-uuid
# QKERN_PRODUCTION_APPLY_SUBJECT_APPROVAL_ID=replace-with-an-approval-uuid
# QKERN_PRODUCTION_APPLY_SUBJECT_DATABASE_INSTANCE_REF=managed:replace-with-opaque-reference
# QKERN_PRODUCTION_APPLY_SUBJECT_STATEMENT_SHA256=replace-with-64-lowercase-hex
# QKERN_PRODUCTION_APPLY_SUBJECT_APPROVAL_ACTION_HASH=replace-with-64-lowercase-hex
# Optional bounded loop controls (defaults shown).
QKERN_WORKER_LEASE_MS=60000
QKERN_WORKER_HEARTBEAT_MS=20000
QKERN_WORKER_IDLE_MS=1000
QKERN_WORKER_RETRY_BASE_MS=1000
QKERN_WORKER_ERROR_MAX_MS=30000
# Apply dispatch is independently enabled and delivered by the bundled signed
# broker host. Keep its timeout at least 1000 ms below the outbox lease.
QKERN_OUTBOX_PUBLISHER_ENABLED=false
QKERN_OUTBOX_PUBLISHER_ID=local-outbox-1
QKERN_OUTBOX_LEASE_MS=30000
QKERN_OUTBOX_RETRY_BASE_MS=1000
QKERN_OUTBOX_RETRY_MAX_MS=60000
QKERN_OUTBOX_IDLE_MS=1000
QKERN_APPLY_BROKER_URL=https://broker.service.internal/qkern/apply
QKERN_APPLY_BROKER_ALLOWED_HOSTS=broker.service.internal
QKERN_APPLY_BROKER_TIMEOUT_MS=10000
# Production requires a private absolute JSON file containing exactly
# {"keyId":"<version>","secret":"<at-least-32-bytes>"}. The host rereads it
# per delivery for atomic rotation. Inline keys below are development-only.
QKERN_APPLY_BROKER_SIGNING_KEY_FILE=/run/qkern/apply-broker-key.json
# QKERN_APPLY_BROKER_HMAC_KEY_ID=local-key-version
# QKERN_APPLY_BROKER_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Incident notifications are independently enabled. The bundled host signs an
# exact-host, no-redirect Pager/Ticket HTTPS webhook. The static environment
# adapter requires a non-secret key ID plus the HMAC secret. Production may
# instead inject a rotating provider; keep the request timeout below the lease.
QKERN_INCIDENT_OUTBOX_PUBLISHER_ENABLED=false
QKERN_INCIDENT_OUTBOX_PUBLISHER_ID=local-incident-outbox-1
QKERN_INCIDENT_OUTBOX_LEASE_MS=30000
QKERN_INCIDENT_OUTBOX_RETRY_BASE_MS=1000
QKERN_INCIDENT_OUTBOX_RETRY_MAX_MS=60000
QKERN_INCIDENT_OUTBOX_IDLE_MS=1000
QKERN_INCIDENT_WEBHOOK_URL=https://pager.example.com/qkern/incidents
QKERN_INCIDENT_WEBHOOK_ALLOWED_HOSTS=pager.example.com
QKERN_INCIDENT_WEBHOOK_HMAC_KEY_ID=replace-with-a-stable-key-version
QKERN_INCIDENT_WEBHOOK_HMAC_SECRET=replace-with-at-least-32-random-bytes
QKERN_INCIDENT_WEBHOOK_TIMEOUT_MS=10000
# ---------------------------------------------------------------------------
# Lokaler Schnellstart (docs/guide/de/SCHNELLSTART.md). Der Dev-Compose legt
# die Datenbank `project_database` mit diesen Logins an. Nur lokal gueltig.
# Sie entsteht nur auf einem frischen Volume; `docker compose down -v` loescht
# dabei alle lokalen Daten.
# Zum Aktivieren weiter unten die vier vorhandenen Schalter
# QKERN_DATA_PLANE_ENABLED, QKERN_ALLOW_LOCAL_PROJECT_DATABASE_CATALOG,
# QKERN_GENERATED_DATA_API_ENABLED und
# QKERN_ALLOW_LOCAL_PROJECT_DATA_API_CATALOG auf true setzen und die beiden
# JSON-Zeilen in diesem Block einkommentieren.
# ---------------------------------------------------------------------------
# QKERN_LOCAL_PROJECT_DATABASE_CATALOG_JSON=[{"databaseInstanceRef":"managed:database-1","connectionString":"postgresql://qkern_project_reader:qkern_reader_local_only@127.0.0.1:5432/project_database","expectedRole":"qkern_project_reader","expectedDatabase":"project_database","expectedLedgerOwner":"qkern_ledger_owner"}]
# QKERN_LOCAL_PROJECT_DATA_API_CATALOG_JSON=[{"databaseInstanceRef":"managed:database-1","connectionString":"postgresql://qkern_project_api_app:qkern_project_api_local_only@127.0.0.1:5432/project_database","expectedRole":"qkern_project_api_app","expectedDatabase":"project_database","expectedLedgerOwner":"qkern_ledger_owner"}]
# Local/E2E only. Production rejects this raw-URL adapter even if enabled.
QKERN_ALLOW_LOCAL_PROJECT_DATABASE_CATALOG=false
# The project Data Plane is disabled by default. Local development may reuse
# the catalog below only with a dedicated, unprivileged read LOGIN. Production
# must inject a separate ProjectDatabaseConnectionResolver that supplies no
# migration-owner capability. Every connection is rechecked for READ ONLY,
# exact role/database, RLS and absence of privileged memberships.
QKERN_DATA_PLANE_ENABLED=false
# Beispiel: siehe Block "Lokaler Schnellstart" oben.
# Generated CRUD uses a separate unprivileged LOGIN with direct table grants,
# no role memberships, no ownership, no BYPASSRLS and active table RLS. It is
# independently disabled. Production must inject a Vault-backed API-role
# resolver; raw URLs are rejected there.
QKERN_GENERATED_DATA_API_ENABLED=false
# Realtime Alpha 1 is an explicit local/controlled-E2E runtime. It binds only
# loopback and refuses NODE_ENV=production until persistent history, horizontal
# fan-out, TLS/proxy certification and real-infrastructure load tests exist.
QKERN_REALTIME_ENABLED=false
QKERN_REALTIME_ALLOWED_ORIGINS=http://localhost:3000
QKERN_REALTIME_PORT=8788
QKERN_REALTIME_HISTORY_PER_CHANNEL=200
QKERN_REALTIME_REPLAY_LIMIT=100
QKERN_REALTIME_MAX_CONNECTIONS=500
QKERN_REALTIME_MAX_SUBSCRIPTIONS=32
QKERN_REALTIME_MAX_MESSAGE_BYTES=32768
QKERN_REALTIME_MAX_PAYLOAD_BYTES=16384
QKERN_REALTIME_MAX_PRESENCE_BYTES=4096
QKERN_REALTIME_MAX_BUFFERED_BYTES=262144
QKERN_REALTIME_AUTH_TIMEOUT_MS=5000
QKERN_REALTIME_HEARTBEAT_MS=30000
# Optional base64url secret with at least 32 decoded bytes. If omitted locally,
# cursors are intentionally invalid after a process restart.
# QKERN_REALTIME_CURSOR_SECRET=replace-with-base64url-encoded-random-secret
# Project Queues Alpha 4 is opt-in. QKERN_RUNTIME_MODE=postgres selects the
# tenant/RLS-bound durable adapter in migration 0026; memory remains development-
# only and is rejected in Production. Origins are exact, never wildcarded.
QKERN_PROJECT_QUEUES_ENABLED=false
QKERN_PROJECT_QUEUES_ALLOWED_ORIGINS=http://localhost:3000
QKERN_PROJECT_QUEUES_MAX_PAYLOAD_BYTES=65536
# Usage Metering Alpha 1 is opt-in. Its browser surface is read-only. Production
# requires QKERN_RUNTIME_MODE=postgres; the memory ledger is development-only.
QKERN_USAGE_METERING_ENABLED=false
# What happens when the measurement itself fails - not when it rejects. A quota
# is a commercial boundary, not a security one: the loss from a briefly uncounted
# operation is bounded and reconcilable, the loss from a platform that refuses
# every request during a database hiccup is not. Set reject to fail closed.
QKERN_USAGE_EMITTER_ON_FAILURE=admit
# Realtime counts in bundles: one booking per batch instead of one per message.
# A crash loses the unwritten buffer, which is the chosen direction - counting
# too little is a loss, counting too much is an invoice for something that never
# happened.
QKERN_REALTIME_USAGE_FLUSH_AT=500
QKERN_REALTIME_USAGE_FLUSH_MS=15000
# Retention has an owner since 1.37. Both prune paths existed for a dozen
# releases without a caller, so the event log and the change feed grew forever.
# The scope list is explicit for the same reason as QKERN_COMPUTE_SCOPES_JSON:
# the runtime role only sees its own organization through RLS. Leaving it empty
# disables retention - and says so, rather than pretending to clean up.
QKERN_REALTIME_RETENTION_SCOPES_JSON=
QKERN_REALTIME_EVENT_RETENTION_MS=604800000
QKERN_REALTIME_CHANGE_RETENTION_MS=86400000
QKERN_REALTIME_RETENTION_INTERVAL_MS=3600000
# Finished webhook deliveries are cleaned up by the compute runtime, which
# already knows the scopes. Waiting and in-flight rows are never touched. Dead
# letters keep a longer window: they are the reason anyone looks at that table.
QKERN_COMPUTE_WEBHOOK_DELIVERED_RETENTION_MS=604800000
QKERN_COMPUTE_WEBHOOK_DEAD_LETTER_RETENTION_MS=2592000000
QKERN_COMPUTE_WEBHOOK_RETENTION_INTERVAL_MS=3600000
# Compute runtime (npm run worker:compute) dispatches cron occurrences and
# delivers webhooks. It requires QKERN_RUNTIME_MODE=postgres and an explicit
# scope list: the runtime role only sees its own organization through RLS, so
# there is no cross-organization discovery of due work.
QKERN_COMPUTE_RUNTIME_ENABLED=false
# REST and Console surface for cron and webhook definitions. Owner and
# administrator only. Requires QKERN_RUNTIME_MODE=postgres and Project Queues,
# because a cron definition must name an existing queue.
QKERN_COMPUTE_DEFINITIONS_ENABLED=false
# Function invocation is opt-in separately: managing definitions is an
# administrative decision, running foreign code is a different one. Requires a
# container runtime on the host of the web process.
QKERN_FUNCTIONS_ENABLED=false
# QKERN_FUNCTIONS_CONTAINER_RUNTIME=docker
# Outbound calls of a function are mediated by this process; the container keeps
# --network none. Every single request is checked against the exact origin
# allowlist of its definition.
# QKERN_FUNCTIONS_EGRESS_MAX_REQUESTS=10
# QKERN_FUNCTIONS_EGRESS_TIMEOUT_MS=10000
# QKERN_COMPUTE_SCOPES_JSON=[{"organizationId":"00000000-0000-0000-0000-000000000000","projectId":"00000000-0000-0000-0000-000000000000","environment":"development"}]
QKERN_COMPUTE_CRON_ENABLED=true
QKERN_COMPUTE_WEBHOOKS_ENABLED=true
QKERN_COMPUTE_CRON_INTERVAL_MS=30000
QKERN_COMPUTE_CRON_MAX_CATCH_UP=5
QKERN_COMPUTE_WEBHOOK_BATCH=5
QKERN_COMPUTE_WEBHOOK_IDLE_MS=1000
QKERN_COMPUTE_WEBHOOK_VISIBILITY_MS=30000
# QKERN_COMPUTE_WORKER_ID=compute-1
# The database webhook bridge (2.53): the compute process reads
# qkern_internal.change_feed of the project databases it serves and turns a
# captured table change into a pending webhook delivery.
#
# Opt-in for the same reason as QKERN_REALTIME_CHANGES_ENABLED: it opens
# connections to customer databases. It needs the webhook delivery loop in the
# same process, and it uses the SAME project database catalog as Realtime
# Changes and the Generated Data API -- QKERN_ALLOW_LOCAL_PROJECT_DATA_API_CATALOG
# and QKERN_LOCAL_PROJECT_DATA_API_CATALOG_JSON below. It is the same
# unprivileged role in the same databases, and db/project/0003 grants the read
# on qkern_internal.change_feed to exactly that role. There is no second
# catalog for the same databases.
#
# Which environments are polled is discovered, not configured: of the scopes in
# QKERN_COMPUTE_SCOPES_JSON, only those that hold at least one database webhook
# coupling are read at all.
QKERN_COMPUTE_DATABASE_WEBHOOKS_ENABLED=false
QKERN_COMPUTE_DATABASE_WEBHOOK_BATCH=100
# Batches per environment and round. The bound keeps one environment with a
# large backlog from starving the others.
QKERN_COMPUTE_DATABASE_WEBHOOK_MAX_BATCHES=10
QKERN_COMPUTE_DATABASE_WEBHOOK_POLL_MS=1000
# Backoff of an unreachable project database. It doubles per consecutive
# failure and is capped at five minutes; the other environments keep running.
QKERN_COMPUTE_DATABASE_WEBHOOK_ERROR_MS=5000
QKERN_COMPUTE_DATABASE_WEBHOOK_DISCOVERY_MS=30000
# The log drain collector (2.64): the compute process reads the five log
# sources of the environments it serves and turns them into signed batches on
# the existing webhook path.
#
# Opt-in for the same reason as the bridge above: it sends log lines to a
# target on the internet. It needs the webhook delivery loop in the same
# process. It does NOT need a project database -- all five sources live in the
# control plane.
#
# Which environments are polled is discovered, not configured: of the scopes in
# QKERN_COMPUTE_SCOPES_JSON, only those that hold at least one log drain are
# touched at all.
#
# The position is durable, per drain AND per source, in
# 0055_project_log_drain_cursors.sql. A restart continues where the last batch
# ended; a drain whose position cannot be read does not start at all.
QKERN_COMPUTE_LOG_DRAINS_ENABLED=false
# A batch goes out when it holds this many entries OR when its oldest entry is
# this old. Without the age a quiet environment would leave its last entries
# lying around; without the count a busy one would send one huge body.
QKERN_COMPUTE_LOG_DRAIN_BATCH_ENTRIES=100
QKERN_COMPUTE_LOG_DRAIN_BATCH_AGE_MS=60000
# Rows read per source and run. The bound keeps one busy source from starving
# the others.
QKERN_COMPUTE_LOG_DRAIN_READ_LIMIT=200
QKERN_COMPUTE_LOG_DRAIN_POLL_MS=1000
# Backoff of a drain that failed. It doubles per consecutive failure and is
# capped at five minutes; the other drains of the same environment keep running.
QKERN_COMPUTE_LOG_DRAIN_ERROR_MS=5000
QKERN_COMPUTE_LOG_DRAIN_DISCOVERY_MS=30000
# The auth expiry retention sweep (2.89): the compute process removes the
# long-expired one-time artefacts of Project Auth.
#
# Opt-OUT, not opt-in, unlike the bridge and the collectors above: those send
# data to the internet, this one deletes rows in the same database. It runs
# over the AUTH connection, because qkern_auth is the only role that sees
# project_auth_one_time_tokens, project_auth_oauth_codes,
# project_auth_oauth_tokens and project_auth_saml_assertions at all; migration
# 0063 grants it the DELETE on the first three and 0070 on the assertion table,
# and no other role gets one. Without QKERN_AUTH_DATABASE_URL the process
# refuses to start instead of quietly doing nothing.
QKERN_COMPUTE_AUTH_RETENTION_ENABLED=true
# The grace after the expiry. 24 hours, and the number is a decision: a row
# that expired a second ago is the subject of the support case that is just
# starting. It is longer than the longest lifetime any of these artefacts can
# have (twelve hours for an OAuth token), so a deleted row can never be the
# counterpart of something still valid. For a SAML replay bar that margin is
# exact: an assertion stays acceptable until 60 seconds past its NotOnOrAfter,
# and the floor of one minute already covers it.
QKERN_COMPUTE_AUTH_RETENTION_GRACE_MS=86400000
# Rows per statement, and statements per table, environment and round. A grown
# table empties over many rounds instead of being locked by one long statement.
QKERN_COMPUTE_AUTH_RETENTION_BATCH=500
QKERN_COMPUTE_AUTH_RETENTION_MAX_BATCHES=10
QKERN_COMPUTE_AUTH_RETENTION_INTERVAL_MS=3600000
# Webhook signing keys. Development only: a signing secret in an environment
# variable appears in every process image and container definition, so this
# provider refuses to exist in Production. The Vault-backed provider is open.
QKERN_ALLOW_LOCAL_WEBHOOK_SIGNING_SECRETS=false
# Vault-backed signing keys (KV version 2). When both values are present the
# Vault provider wins and the environment provider is not built at all — a
# forgotten local key must never quietly win in production. Half a
# configuration is an error, not a fallback. The token is read from the file
# referenced by QKERN_VAULT_TOKEN_FILE, so a Vault Agent sink rotates
# automatically.
# QKERN_WEBHOOK_VAULT_KV_URL=https://vault.service.internal:8200/v1/secret
# QKERN_WEBHOOK_VAULT_TIMEOUT_MS=5000
# QKERN_WEBHOOK_VAULT_CACHE_TTL_MS=60000
# QKERN_LOCAL_WEBHOOK_SIGNING_SECRETS_JSON={"vault:webhook/orders":{"keyId":"local-1","secret":"replace-with-base64url-encoded-32-bytes"}}
QKERN_ALLOW_LOCAL_PROJECT_DATA_API_CATALOG=false
# Beispiel: siehe Block "Lokaler Schnellstart" oben.
# Production resolves provisioner-created, secret-free bindings from the Control
# Plane and obtains passwords only from Vault. static-env is a compatibility mode.
QKERN_PROJECT_DATABASE_CATALOG_SOURCE=control-plane
QKERN_VAULT_DATABASE_URL=https://vault.service.internal:8200/v1/database
QKERN_VAULT_TOKEN_FILE=/run/qkern/vault/token
# QKERN_VAULT_NAMESPACE=tenant/namespace
QKERN_VAULT_TIMEOUT_MS=5000
QKERN_VAULT_REFRESH_SKEW_MS=30000
# Legacy only with QKERN_PROJECT_DATABASE_CATALOG_SOURCE=static-env:
# QKERN_VAULT_PROJECT_DATABASE_CATALOG_JSON=[{"databaseInstanceRef":"managed:database-1","vaultStaticRole":"project-database-1","host":"db.customer.example","port":5432,"expectedRole":"qkern_project_migrator","expectedDatabase":"project_database","expectedLedgerOwner":"qkern_ledger_owner","serverCertificateSha256":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}]
# Local Docker may disable TLS. Production requires exactly DATABASE_SSL=require
# and verifies the server certificate.
DATABASE_SSL=disable
# Exactly 32 bytes encoded as 64 hex characters or base64. Rotate through a
# managed secret store; changing it makes existing encrypted statements unreadable.
QKERN_STATEMENT_ENCRYPTION_KEY=replace-with-32-bytes-as-hex-or-base64
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000

# --- Project queue host (1.42) -----------------------------------------------
# The process that actually consumes queue messages: `npm run worker:queues`.
#
# ProjectQueueWorker existed since Alpha 1 and no entrypoint ever started it -
# messages could be enqueued and nothing took them out. That was found by the
# reachability contract, not by hand; see tests/entrypoint-reachability-contract.
#
# Each binding hands one queue to one registered function. The list is explicit
# for the same reason as QKERN_COMPUTE_SCOPES_JSON: the runtime role only sees
# its own organization through RLS, so there is nothing to discover.
#
# Needs QKERN_PROJECT_QUEUES_ENABLED=true and QKERN_FUNCTIONS_ENABLED=true.
QKERN_QUEUE_WORKER_ENABLED=false
# QKERN_QUEUE_WORKER_BINDINGS_JSON=[{"organizationId":"00000000-0000-0000-0000-000000000000","projectId":"00000000-0000-0000-0000-000000000000","environment":"development","queue":"orders","functionName":"settle-order"}]
QKERN_QUEUE_WORKER_IDLE_MS=1000
QKERN_QUEUE_WORKER_ERROR_MS=2000
