postgres-1       | 2026-09-25 17:59:17.814 UTC [444] STATEMENT:  -- Run once after 0002_qkern_migration_fence.sql as the trusted project database
postgres-1       | 	-- provisioner. Provides trigger-based change capture for Realtime.
postgres-1       | 	--
postgres-1       | 	-- ## Warum Trigger und nicht logische Replikation
postgres-1       | 	--
postgres-1       | 	-- Logische Replikation sieht jede Aenderung ohne Schemaeingriff, verlangt aber
postgres-1       | 	-- eine Rolle mit Replikationsrecht und einen Slot. Beides steht im direkten
postgres-1       | 	-- Widerspruch zu diesem Schema: 0001 prueft fuer jede beteiligte Rolle
postgres-1       | 	-- ausdruecklich rolreplication = false. Ein hängender Konsument laesst den Slot
postgres-1       | 	-- ausserdem unbegrenzt WAL halten, bis die Platte voll ist -- ein
postgres-1       | 	-- Betriebsrisiko, das der Kunde traegt und QKERN nicht begrenzen kann.
postgres-1       | 	--
postgres-1       | 	-- Trigger sind begrenzbar: der Feed hat Groessengrenzen und Aufbewahrung, und
postgres-1       | 	-- das Anschalten je Tabelle ist eine Schemaaenderung, die den vorhandenen
postgres-1       | 	-- Change-Set- und Approval-Weg durchlaeuft.
postgres-1       | 	--
postgres-1       | 	-- ## Warum keine Zeilenwerte gespeichert werden
postgres-1       | 	--
postgres-1       | 	-- Der Feed haelt ausschliesslich die Primaerschluesselwerte. Die eigentlichen
postgres-1       | 	-- Zeilenwerte werden je Abonnent frisch gelesen, und zwar mit dessen Claims.
postgres-1       | 	-- Row Level Security autorisiert und erzeugt die Nutzlast damit in einem
postgres-1       | 	-- Schritt. Wuerden die Werte hier liegen, muesste eine zweite, unabhaengige
postgres-1       | 	-- Sichtbarkeitspruefung sie korrekt filtern -- eine Kopie der RLS-Logik
postgres-1       | 	-- ausserhalb der Datenbank und damit eine dauerhafte Fehlerquelle.
postgres-1       | 	
postgres-1       | 	BEGIN;
postgres-1       | 	
postgres-1       | 	CREATE TABLE qkern_internal.change_feed (
postgres-1       | 	  position bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
postgres-1       | 	  schema_name text NOT NULL CHECK (schema_name ~ '^[a-z_][a-z0-9_]{0,62}$'),
postgres-1       | 	  table_name text NOT NULL CHECK (table_name ~ '^[a-z_][a-z0-9_]{0,62}$'),
postgres-1       | 	  operation text NOT NULL CHECK (operation IN ('insert', 'update', 'delete')),
postgres-1       | 	  -- Nur Primaerschluesselwerte. Die Grenze verhindert, dass ein zusammengesetzter
