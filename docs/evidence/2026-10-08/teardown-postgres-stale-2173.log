postgres-1       | 	-- SECURITY DEFINER: Der Schreiber einer Zeile besitzt keine Rechte auf dem
postgres-1       | 	-- Feed und soll sie auch nicht bekommen. Der Trigger schreibt stellvertretend.
postgres-1       | 	-- search_path wird fest gesetzt, damit kein Aufrufer die aufgeloesten Objekte
postgres-1       | 	-- umlenken kann.
postgres-1       | 	CREATE OR REPLACE FUNCTION qkern_internal.capture_change()
postgres-1       | 	RETURNS trigger
postgres-1       | 	LANGUAGE plpgsql
postgres-1       | 	SECURITY DEFINER
postgres-1       | 	SET search_path = qkern_internal, pg_catalog
postgres-1       | 	AS $$
postgres-1       | 	DECLARE
postgres-1       | 	  key_columns text[];
postgres-1       | 	  source record;
postgres-1       | 	  key jsonb;
postgres-1       | 	BEGIN
postgres-1       | 	  SELECT array_agg(attribute.attname ORDER BY attribute.attnum)
postgres-1       | 	    INTO key_columns
postgres-1       | 	    FROM pg_index index
postgres-1       | 	    JOIN pg_attribute attribute
postgres-1       | 	      ON attribute.attrelid = index.indrelid AND attribute.attnum = ANY (index.indkey)
postgres-1       | 	   WHERE index.indrelid = TG_RELID AND index.indisprimary;
postgres-1       | 	
postgres-1       | 	  IF key_columns IS NULL THEN
postgres-1       | 	    RAISE EXCEPTION 'change capture requires a primary key on %.%', TG_TABLE_SCHEMA, TG_TABLE_NAME
postgres-1       | 	      USING ERRCODE = '55000';
postgres-1       | 	  END IF;
postgres-1       | 	
postgres-1       | 	  source := CASE WHEN TG_OP = 'DELETE' THEN OLD ELSE NEW END;
postgres-1       | 	  SELECT jsonb_object_agg(entry.key, entry.value)
postgres-1       | 	    INTO key
postgres-1       | 	    FROM jsonb_each(to_jsonb(source)) AS entry
postgres-1       | 	   WHERE entry.key = ANY (key_columns);
postgres-1       | 	
postgres-1       | 	  INSERT INTO qkern_internal.change_feed (schema_name, table_name, operation, row_key)
postgres-1       | 	  VALUES (TG_TABLE_SCHEMA, TG_TABLE_NAME, lower(TG_OP), key);
postgres-1       | 	
postgres-1       | 	  RETURN NULL;
postgres-1       | 	END;
postgres-1       | 	$$;
postgres-1       | 	
postgres-1       | 	ALTER FUNCTION qkern_internal.capture_change() OWNER TO qkern_ledger_owner;
postgres-1       | 	
postgres-1       | 	REVOKE ALL ON qkern_internal.change_feed FROM PUBLIC;
postgres-1       | 	REVOKE ALL ON FUNCTION qkern_internal.capture_change() FROM PUBLIC;
postgres-1       | 	
postgres-1       | 	-- Die Laufzeitrolle liest den Feed und raeumt ihn auf. Sie darf ihn niemals
postgres-1       | 	-- schreiben: ein erfundenes Aenderungsereignis wuerde einen Lesevorgang mit
postgres-1       | 	-- fremden Claims ausloesen.
postgres-1       | 	GRANT USAGE ON SCHEMA qkern_internal TO qkern_project_api_app;
postgres-1       | 	GRANT SELECT, DELETE ON qkern_internal.change_feed TO qkern_project_api_app;
postgres-1       | 	
postgres-1       | 	COMMIT;
