+   noProbe: "errorNoProbe",
+ };
+ 
+ function evidence(measure: HealthMeasureId, count: number | null = null): HealthEvidence {
+   // MUTATION: das Mass wandert roh in die Beschriftung
+   return { measure, label: `${HEALTH_MEASURES[measure]} (${measure})`, count };
+ }
+ 
+ function report(
