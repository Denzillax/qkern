{
  "name": "qkern-platform",
  "version": "2.38.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:packages && next build",
    "build:sdk": "tsc -p sdk/typescript/tsconfig.build.json",
    "build:cli": "tsc -p cli/tsconfig.build.json",
    "build:packages": "npm run build:sdk && npm run build:cli",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run tests/postgres.integration.test.ts tests/postgres-incident-recovery.integration.test.ts tests/generated-data-postgres.integration.test.ts tests/project-auth-postgres.integration.test.ts tests/project-storage-postgres.integration.test.ts tests/project-queues-postgres.integration.test.ts tests/usage-metering-postgres.integration.test.ts tests/realtime-postgres.integration.test.ts tests/realtime-change-feed-postgres.integration.test.ts tests/realtime-change-chain-postgres.integration.test.ts tests/realtime-change-soak-postgres.integration.test.ts tests/project-queues-multi-instance.integration.test.ts tests/compute-cron-postgres.integration.test.ts tests/compute-webhook-postgres.integration.test.ts tests/compute-webhook-chain.integration.test.ts tests/compute-definitions-postgres.integration.test.ts tests/compute-functions-postgres.integration.test.ts tests/usage-emitters-postgres.integration.test.ts tests/migration-process-postgres.integration.test.ts tests/realtime-process-postgres.integration.test.ts tests/provisioning-port-postgres.integration.test.ts tests/migration-enqueue-postgres.integration.test.ts tests/sql-privilege-clause-contract.integration.test.ts tests/queue-connection-pressure-postgres.integration.test.ts tests/usage-billing-postgres.integration.test.ts tests/billing-invoice-postgres.integration.test.ts tests/data-plane-query-postgres.integration.test.ts tests/data-plane-triggers-postgres.integration.test.ts tests/data-plane-functions-postgres.integration.test.ts tests/data-plane-catalog-postgres.integration.test.ts tests/data-plane-catalog-wide-postgres.integration.test.ts",
    "test:postgres:docker": "node scripts/postgres-certification.mjs",
    "test:storage:provider": "vitest run tests/project-storage-provider.integration.test.ts",
    "test:storage:docker": "node scripts/storage-certification.mjs",
    "test:backup:docker": "node scripts/backup-certification.mjs",
    "storage:bucket": "node scripts/storage-create-bucket.mjs",
    "dev:bind-project-database": "node scripts/dev-bind-project-database.mjs",
    "verify:backup-restore": "node --import tsx scripts/verify-backup-restore-evidence.ts",
    "render:runtime-deployments": "node --import tsx scripts/render-background-runtime-deployments.ts",
    "verify:runtime-deployments": "node --import tsx scripts/verify-background-runtime-deployments.ts",
    "verify:runtime-deployment-evidence": "node --import tsx scripts/verify-background-runtime-deployment-evidence.ts",
    "verify:provider-e2e": "node --import tsx scripts/verify-provider-e2e-evidence.ts",
    "verify:security-assessment": "node --import tsx scripts/verify-security-assessment-evidence.ts",
    "verify:release-evidence": "node --import tsx scripts/verify-release-evidence-readiness.ts",
    "verify:production-readiness": "node --import tsx scripts/verify-production-readiness.ts",
    "verify:production-apply": "node --import tsx scripts/verify-production-apply-authorization.ts",
    "mcp": "node --import tsx mcp/server.ts",
    "mcp:http": "node --import tsx mcp/http-server.ts",
    "qkern": "node --import tsx cli/src/main.ts",
    "verify:dx": "node --import tsx scripts/verify-developer-experience.ts",
    "verify:packages": "node scripts/verify-package-tarballs.mjs",
    "verify:dx:full": "npm run build:packages && npm run verify:dx && npm run verify:packages",
    "realtime": "node --import tsx workers/realtime-runtime.mts",
    "worker:migrations": "node --import tsx workers/migration-runtime.mts",
    "worker:billing-invoices": "node --import tsx workers/billing-invoice-runtime.mts",
    "worker:migrations:local": "node --import tsx workers/migration-runtime.mts",
    "provisioner:projects": "node --import tsx workers/project-provisioning-runtime.mts",
    "publisher:apply": "node --import tsx workers/apply-outbox-runtime.mts",
    "publisher:incidents": "node --import tsx workers/incident-outbox-runtime.mts",
    "worker:compute": "node --import tsx workers/compute-runtime.mts",
    "worker:queues": "node --import tsx workers/project-queue-runtime.mts",
    "test:auth:provider": "vitest run tests/project-auth-provider.integration.test.ts",
    "test:auth:docker": "node scripts/auth-certification.mjs",
    "test:functions:docker": "node scripts/functions-certification.mjs",
    "test:vault": "vitest run tests/webhook-vault.integration.test.ts",
    "test:vault:docker": "node scripts/vault-certification.mjs",
    "test:receiver": "vitest run tests/receiver.integration.test.ts",
    "test:receiver:docker": "node scripts/receiver-certification.mjs",
    "usage:export": "node --import tsx scripts/export-usage-events.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "lucide-react": "1.25.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "pgsql-ast-parser": "^12.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "^4.21.0",
    "ws": "8.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "8.18.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "fast-uri": "4.1.2",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
